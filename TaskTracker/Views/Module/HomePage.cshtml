@{
    Layout = "~/Views/Shared/_TaskTrackerLayout.cshtml";
}


<p ng-init="titleFunc()"></p>
<input type="text" ng-model="firstName" />
<input type="text" ng-model="lastName" />
<button ng-click="registrationFunc()">Submit</button>
<button ng-click="clearFunc()">Clear</button>

<div>
    <table>
        <thead>
            <tr>
                <th>First Name</th>
                <th>Last Name</th>
            </tr>
        </thead>
        <tbody>
            <tr ng-repeat="udata in userArray">
                <td>{{udata.firstname}}</td>
                <td>{{udata.lastname}}</td>
            </tr>
        </tbody>
    </table>
</div>