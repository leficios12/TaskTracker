@{
    Layout = "~/Views/Shared/_TaskTrackerLayout.cshtml";
}

<div class="max-w-xl mx-auto px-6 py-10">

    <div class="bg-white rounded-xl shadow-lg border border-gray-100">
        <div class="bg-sky-950 px-6 py-4 text-center">
            <h2 class="text-lg font-semibold text-white">User Login</h2>
            <p class="text-sky-200 text-sm">Please enter your credentials</p>
        </div>

        <div class="p-6">
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">*Username</label>
                <input type="text" ng-model="userName" class="w-full mb-3 px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-sky-500 focus:border-sky-500 transition" />
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">*Password</label>
                <input type="password" ng-model="Password" class="w-full mb-3 px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-sky-500 focus:border-sky-500 transition" />
            </div>


            <div class="flex gap-3 p-6">
                <button ng-click="redirectHomePage()" class="flex-1 bg-sky-950 text-white px-4 py-2 rounded-md hover:bg-sky-900 active:scale-95 transition">Login</button>
                <button ng-click="clearFunc()" class="flex-1 border border-gray-300 text-gray-700 px-4 py-2 rounded-md hover:bg-gray-50 active:scale-95 transition">Clear</button>
            </div>
            <div class="text-center my-5">
                <p>Don't have an account? 
                <a href="/Module/RegistrationPage" class="text-sky-700 hover:text-sky-400">Register here</a></p>
            </div>
        </div>
    </div>
</div>