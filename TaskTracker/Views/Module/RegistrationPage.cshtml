@{
    Layout = "~/Views/Shared/_TaskTrackerLayout.cshtml";
}


<div class="max-w-xl mx-auto px-6 py-10">

    <div class="bg-white rounded-xl shadow-lg border border-gray-100">
        <div class="bg-sky-950 px-6 py-4 text-center">
            <h2 class="text-lg font-semibold text-white">User Registration</h2>
            <p class="text-sky-200 text-sm">Fill in the details below</p>
        </div>

        <div class="p-6">
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">*Username (min: 3, max: 20)</label>
                <input type="text" ng-model="userName" maxlength="20" minlength="3" class="w-full mb-3 px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-sky-500 focus:border-sky-500 transition" />
            </div>

            <div class="flex gap-3">
                <div class="flex-1">
                    <label class="block text-sm font-medium text-gray-700 mb-1">*First Name (min: 3, max: 28)</label>
                    <input type="text" ng-model="firstName" maxlength="28" minlength="3" class="w-full mb-3 px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-sky-500 focus:border-sky-500 transition" />
                </div>
                <div class="flex-1">
                    <label class="block text-sm font-medium text-gray-700 mb-1">*Last Name (min: 3, max: 28)</label>
                    <input type="text" ng-model="lastName" maxlength="28" minlength="3" class="w-full mb-3 px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-sky-500 focus:border-sky-500 transition" />
                </div>
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">*Email</label>
                <input type="text" ng-model="Email" maxlength="100" minlength="5" class="w-full mb-3 px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-sky-500 focus:border-sky-500 transition" />
            </div>

            <div class="flex gap-3">
                <div class="flex-1">
                    <label class="block text-sm font-medium text-gray-700 mb-1">*Password (min: 6, max: 30)</label>
                    <input type="password" ng-model="Password" maxlength="30" minlength="6" class="w-full mb-5 px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-sky-500 focus:border-sky-500 transition" />
                </div>
                <div class="flex-1">
                    <label class="block text-sm font-medium text-gray-700 mb-1">*Confirm Password (min: 6, max: 30)</label>
                    <input type="password" ng-model="ConfirmPassword" maxlength="30" minlength="6" class="w-full mb-5 px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-sky-500 focus:border-sky-500 transition" />
                </div>
            </div>

            <div class="flex gap-3 py-5">
                <button ng-click="registrationFunc()" class="flex-1 bg-sky-950 text-white px-4 py-2 rounded-md hover:bg-sky-900 active:scale-95 transition">Submit</button>
                <button ng-click="clearFunc()" class="flex-1 border border-gray-300 text-gray-700 px-4 py-2 rounded-md hover:bg-gray-50 active:scale-95 transition">Clear</button>
            </div>
            <div class="text-center my-5">
                <p>
                    Already have an account?
                    <a href="/Module/LoginPage" class="text-sky-700 hover:text-sky-400">Login here</a>
                </p>
            </div>
        </div>
    </div>

    <table class="w-full mt-8 border rounded-lg overflow-hidden">
        <thead class="bg-gray-50">
            <tr class="border-b">
                <th class="text-left px-7 py-3 text-sm font-semibold text-gray-600 whitespace-nowrap">ID</th>
                <th class="text-left px-7 py-3 text-sm font-semibold text-gray-600 whitespace-nowrap">Username</th>
                <th class="text-left px-7 py-3 text-sm font-semibold text-gray-600 whitespace-nowrap">First Name</th>
                <th class="text-left px-7 py-3 text-sm font-semibold text-gray-600 whitespace-nowrap">Last Name</th>
                <th class="text-left px-7 py-3 text-sm font-semibold text-gray-600 whitespace-nowrap">Email</th>
                <th class="text-left px-7 py-3 text-sm font-semibold text-gray-600 whitespace-nowrap">Actions</th>
            </tr>
        </thead>
        <tbody>
            <tr ng-repeat="udata in userArray" class="border-b hover:bg-gray-50">
                <td class="px-5 py-3">{{udata.id}}</td>
                <td class="px-5 py-3">{{udata.username}}</td>
                <td class="px-5 py-3">{{udata.firstname}}</td>
                <td class="px-5 py-3">{{udata.lastname}}</td>
                <td class="px-5 py-3">{{udata.email}}</td>
                <td class="px-5 py-3">
                    <button ng-click="editFunc($index)" class="my-1 bg-emerald-500 hover:bg-emerald-700 text-white font-bold py-1 px-4 border border-emerald-700 rounded">Edit</button>
                    <button ng-click="deleteFunc($index)" class="my-1 bg-red-500 hover:bg-red-700 text-white font-bold py-1 px-4 border border-red-700 rounded">Delete</button>
                </td>
            </tr>
        </tbody>
    </table>

</div>