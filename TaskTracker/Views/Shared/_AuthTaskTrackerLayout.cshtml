<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body ng-app="TaskTrackerModule" ng-controller="TaskTrackerController" class="min-h-screen flex flex-col">

    <nav class="bg-sky-950 shadow-md">
        <div class="max-w-6xl mx-auto flex items-center justify-between px-6 py-4">
            <a href="" class="flex items-center">
                <img src="~/Content/images/NexTaskLogo.png" alt="NexTask Logo" class="h-14 w-auto" />


            </a>
        </div>
    </nav>

    <div class="flex-1">
        @RenderBody()
    </div>

    <footer class="bg-sky-950 mt-auto">
        <div class="max-w-6xl mx-auto px-6 py-8">
            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6">
                <div>
                    <img src="~/Content/images/NexTaskLogo.png" alt="NexTask Logo" class="h-14 w-auto" />
                    <p class="text-sm text-sky-200 mt-1">Simple task management for everyone.</p>
                </div>
            </div>
            <div class="border-t border-sky-800 mt-6 pt-6 text-sm text-sky-300 text-center">
                © 2026 NexTask. All rights reserved.
            </div>
        </div>
    </footer>

    <script src="~/Scripts/jquery-3.7.0.min.js"></script>
    <script src="~/Scripts/angular.min.js"></script>
    <script src="~/Scripts/TrinityScripts/Module.js"></script>
    <script src="~/Scripts/TrinityScripts/Service.js"></script>
    <script src="~/Scripts/TrinityScripts/Controller.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</body>
</html>